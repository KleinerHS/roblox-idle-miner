{
  "name": "RobloxIdleMiner",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$path": "src/server"
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/client"
      }
    },
    "MaterialService": {
      "$ignoreUnknownInstances": true,
      "RustyPickupPaint": {
        "$path": "src/materials/RustyPickupPaint.model.json"
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      }
    }
  }
}
